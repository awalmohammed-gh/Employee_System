{
  "name": "employee-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=client",
    "build:frontend": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "dev": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "node server.js",
    "dev:all": "node server.js",
    "start": "node server.js",
    "seed": "node backend/scripts/seedRealData.js",
    "seed:admin": "node backend/scripts/seedAdmin.js",
    "test": "node --test tests/tenantIsolation.test.js",
    "test:isolation": "node --test tests/tenantIsolation.test.js",
    "audit:aggregations": "node scripts/auditAggregationPipelines.js",
    "audit:tenant-models": "node backend/scripts/listTenantModels.js",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/crossCompanyIsolation.jest.test.js --runInBand",
    "db:purge-test-seeds": "node scripts/purgeMockCompanies.js",
    "db:reset": "node scripts/reset-db.js",
    "lint": "npm run lint --workspace=client",
    "db:normalize-attendance-dates": "node backend/scripts/normalizeAttendanceDates.js",
    "db:remove-seeded-reviews": "node backend/scripts/removeSeededPerformanceReviews.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf-autotable": "^5.0.8",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "validator": "^13.15.35",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
